  m_Script: {fileID: 11500000, guid: 1b34b7099d8c15b4aa532f7f1156c750, type: 3}
  m_Name: Brown haired rich  woman dialogue
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSegmentScriptable
  dialoguePieces:
  - characterName: NPC
    text: Hello there darling.
    playerChoices: []
  - characterName: NPC
    text: I have a small request to make of you.
    playerChoices: []
  - characterName: NPC
    text: I am so tired of my current eye colour, and I was wondering if you had
      any young eyes?
    playerChoices: []
  - characterName: NPC
    text: I don't really wanna have these failing lumps anymore.
    playerChoices: []
  - characterName: NPC
    text: Could you do that for me? I'll pay you well...
    playerChoices: []
  - characterName: NPC
    text: It would make my DAY if you could!
    playerChoices: []
