  m_Script: {fileID: 11500000, guid: 1b34b7099d8c15b4aa532f7f1156c750, type: 3}
  m_Name: Blonde woman dialogue
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSegmentScriptable
  dialoguePieces:
  - characterName: NPC
    text: Why hello there cutie!
    playerChoices: []
  - characterName: NPC
    text: Listen, could you do me a favour?
    playerChoices: []
  - characterName: NPC
    text: I really need some new lips, that are normal and pale! Nothing damaged.
    playerChoices: []
  - characterName: NPC
    text: My ones are so dry and never moisten up! I got them from some old hag on
      the street!
    playerChoices: []
  - characterName: NPC
    text: Would you be able to do that for me sweetie???
    playerChoices: []
  - characterName: NPC
    text: It would make my DAY if you could!
    playerChoices: []
